+void SystemTray::showTrayItem(const QString &itemId)
+{
+    if (!m_settings || itemId.isEmpty()) {
+        return;
+    }
+
+    m_settings->showItem(itemId);
+}
+
+void SystemTray::hideTrayItem(const QString &itemId)
+{
+    if (!m_settings || itemId.isEmpty()) {
+        return;
+    }
+
+    m_settings->hideItem(itemId);
+}
+
+void SystemTray::reorderTrayItem(const QString &itemId, const QString &targetItemId, bool before)
+{
+    if (!m_settings || itemId.isEmpty() || targetItemId.isEmpty() || itemId == targetItemId) {
+        return;
+    }
+
+    QStringList order = m_settings->itemOrder();
+
+    auto *model = sortedSystemTrayModel();
+    for (int row = 0; row < model->rowCount(); ++row) {
+        const QString id = model->data(model->index(row, 0), static_cast<int>(BaseModel::BaseRole::ItemId)).toString();
+        if (!id.isEmpty() && !order.contains(id)) {
+            order.append(id);
+        }
+    }
+
+    order.removeAll(itemId);
+
+    const int targetIndex = order.indexOf(targetItemId);
+    if (targetIndex < 0) {
+        order.append(itemId);
+    } else {
+        order.insert(targetIndex + (before ? 0 : 1), itemId);
+    }
+
+    m_settings->setItemOrder(order);
+}

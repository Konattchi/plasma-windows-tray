+void SystemTraySettings::showItem(const QString &itemId)
+{
+    if (itemId.isEmpty()) {
+        return;
+    }
+
+    QStringList hidden = hiddenItems();
+    hidden.removeAll(itemId);
+
+    QStringList shown = shownItems();
+    if (!shown.contains(itemId)) {
+        shown.append(itemId);
+    }
+
+    writeConfigValue(HIDDEN_ITEMS_KEY, hidden);
+    writeConfigValue(SHOWN_ITEMS_KEY, shown);
+}
+
+void SystemTraySettings::hideItem(const QString &itemId)
+{
+    if (itemId.isEmpty()) {
+        return;
+    }
+
+    QStringList shown = shownItems();
+    shown.removeAll(itemId);
+
+    QStringList hidden = hiddenItems();
+    if (!hidden.contains(itemId)) {
+        hidden.append(itemId);
+    }
+
+    writeConfigValue(SHOWN_ITEMS_KEY, shown);
